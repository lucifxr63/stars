# BralidusPY — Variables de entorno
# Copia como .env y completa los valores (solo para desarrollo local)
# En Railway: agregar como Environment Variables en el dashboard

# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # NUNCA exponer en frontend

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── FRED (Federal Reserve St. Louis) ─────────────────────────────────────────
# Gratis en: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=...

# ── Auth de la API ────────────────────────────────────────────────────────────
# REQUERIDO EN PRODUCCIÓN. Genera con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Agregar el mismo valor en Supabase secrets como BRALIDUS_API_KEY
BRALIDUS_API_KEY=

# ── CORS (Railway/Fly.io) ─────────────────────────────────────────────────────
# Lista de orígenes permitidos separados por coma.
# En Railway, Railway inyecta el dominio automáticamente — puedes dejar vacío
# para usar los defaults hardcodeados (validus.scouttech.lat, localhost).
ALLOWED_ORIGINS=https://validus.scouttech.lat,http://localhost:5173

# ── Puerto ────────────────────────────────────────────────────────────────────
# Railway inyecta PORT automáticamente. No es necesario configurarlo.
# PORT=8000

# ── Phase 3 — OpenBB (opcional) ───────────────────────────────────────────────
# Activar solo si openbb está instalado: pip install openbb>=4.3.3 && openbb-build
# OPENBB_ENABLED=true
