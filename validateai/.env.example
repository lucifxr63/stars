# ─── Validus — variables de entorno (ejemplo) ────────────────────────────────
# Copia a `.env.local` y rellena. NO subas `.env.local` ni secrets reales al repo.
# Solo las variables con prefijo VITE_ se exponen al frontend (son públicas/anon).

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Analítica de producto (opcional en dev; sin esto los eventos son no-op seguros)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# ── Checkout / cobro (Fase 12) ───────────────────────────────────────────────
# Toggle del frontend. 'true' → los CTAs de pago van a LemonSqueezy (Edge create-checkout).
# Ausente o 'false' → fallback a la waitlist Early Bird (sin cargos). Default: off.
VITE_CHECKOUT_ENABLED=false
# Modo informativo para badges/analítica. test | live
VITE_CHECKOUT_MODE=test

# ─── Secrets de SERVIDOR (NO van aquí) ───────────────────────────────────────
# Se configuran como Supabase Edge Function secrets, NUNCA en el frontend ni en el repo:
#   LEMONSQUEEZY_API_KEY          # API key de LemonSqueezy
#   LS_STORE_ID                   # Store ID
#   LS_VARIANT_BASIC              # Variant ID del plan Basic
#   LS_VARIANT_PRO                # Variant ID del plan Pro
#   LS_VARIANT_PREMIUM            # Variant ID del plan Premium
#   LEMONSQUEEZY_WEBHOOK_SECRET   # Secret para validar la firma del webhook
#   SUPABASE_SERVICE_ROLE_KEY     # (ya usado por las Edge Functions)
# Ver docs/LEMONSQUEEZY_ACTIVATION_PLAN.md para el checklist completo.
#
# ── Notificación de pilotos (Edge `pilot-notify`, Fase 3A) ───────────────────
#   RESEND_API_KEY                # (reutilizado) sin esto → DRY RUN, no envía email
#   FROM_EMAIL                    # (reutilizado) remitente, ej: "Validus <hola@scouttech.lat>"
#   PILOT_NOTIFY_TO               # destino interno del aviso; default contacto@scouttech.lat
